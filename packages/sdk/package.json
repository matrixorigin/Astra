{
  "name": "@astra/sdk",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "TypeScript SDK for Astra — streaming chat, tool execution, and WebSocket support",
  "homepage": "https://github.com/matrixorigin/Astra#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matrixorigin/Astra.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/matrixorigin/Astra/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai-agent",
    "enterprise-ai",
    "llm",
    "sdk",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:online": "node scripts/sdk-online-smoke.mjs",
    "test:integration:local": "ASTRA_SDK_E2E=1 vitest run src/__tests__/integration/online",
    "test:integration:remote": "node scripts/run-remote-integration.mjs",
    "ci": "npm run typecheck && npm run test:coverage && npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "postcss": "^8.5.23",
    "undici": "7.29.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.14.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
