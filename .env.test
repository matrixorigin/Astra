# Test database configuration
# Use separate MatrixOne instance or database for testing

# Option 1: Same MatrixOne instance, different database
TEST_MATRIXONE_HOST=localhost
TEST_MATRIXONE_PORT=6001
TEST_MATRIXONE_USER=root
TEST_MATRIXONE_PASSWORD=111
TEST_MATRIXONE_DATABASE=test_dev_agent

# Option 2: Completely separate MatrixOne instance (recommended for CI)
# TEST_MATRIXONE_HOST=test-matrixone.example.com
# TEST_MATRIXONE_PORT=6001
# TEST_MATRIXONE_USER=test_user
# TEST_MATRIXONE_PASSWORD=test_password
# TEST_MATRIXONE_DATABASE=test_dev_agent

# Option 3: Docker test instance
# TEST_MATRIXONE_HOST=localhost
# TEST_MATRIXONE_PORT=6002
# TEST_MATRIXONE_USER=root
# TEST_MATRIXONE_PASSWORD=111
# TEST_MATRIXONE_DATABASE=test_dev_agent
