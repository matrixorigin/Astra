# Astra Gateway 配置
#
# 启动:
#   make gateway                        # 或直接:
#   cargo run -p astra-gateway --release -- --config gateway.yaml
#
# 微信登录:
#   make gateway-login-weixin           # 扫码获取 token, 填入下方 weixin 配置
#
# 环境变量覆盖:
#   WECOM_BOT_ID, WECOM_SECRET — 企微凭证
#   WEIXIN_TOKEN, WEIXIN_ACCOUNT_ID — 微信凭证
#   GATEWAY_DATABASE_URL — 数据库连接

astra:
  base_url: "http://127.0.0.1:8000"    # Astra server 地址
  api_key: ""                          # Astra API key (如开启认证)
  default_model: "MiniMax-M2.7"       # 默认模型

database:
  url: "mysql://root:111@127.0.0.1:6001/astra_gateway"  # Gateway 独立数据库

# 默认 CLI
cli:
  type: astra
  bin: "/home/xupeng/astra/rust/target/release/astra"
  permission_mode: auto
  model: "MiniMax-M2.7"

# 可切换的 CLI 列表
cli_profiles:
  claude:
    type: claude
    bin: "/home/xupeng/.local/bin/claude"
  astra:
    type: astra
    bin: "/home/xupeng/astra/rust/target/release/astra"
    permission_mode: auto
    model: "MiniMax-M2.7"

# 至少启用一个平台
platforms:
  # ── 微信个人号 (iLink Bot API) ──
  # 首次使用: make gateway-login-weixin 扫码获取 token
  weixin:
    enabled: true
    token: "7cb90c87fb92@im.bot:0600005a27a5cae5c9d49ecde727d72f029bc7"
    account_id: "7cb90c87fb92@im.bot"

  # ── 企业微信 AI Bot ──
  # wecom:
  #   enabled: true
  #   bot_id: ""                       # 企微 AI Bot ID
  #   secret: ""                       # 企微 AI Bot Secret
  #   # websocket_url: "wss://openws.work.weixin.qq.com"
