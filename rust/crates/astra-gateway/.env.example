# Astra Gateway Environment Variables
# Copy to .env and edit, or export directly.

# ── Database (MatrixOne/MySQL) ──
GATEWAY_DATABASE_URL=mysql://root:111@127.0.0.1:6001/astra_gateway

# ── WeChat iLink ──
# Run `make login-weixin` to get these via QR scan.
# Or set manually after scanning.
WEIXIN_TOKEN=
WEIXIN_ACCOUNT_ID=

# ── WeCom (Enterprise WeChat) ──
WECOM_BOT_ID=
WECOM_SECRET=

# ── Astra Server ──
# Required for astra CLI backend.
ASTRA_API_URL=http://127.0.0.1:8000
# Auto-login credentials (gateway registers/refreshes on startup)
ASTRA_USERNAME=gateway
ASTRA_PASSWORD=gateway123

# ── Claude (Bedrock) ──
# Required for claude CLI backend.
CLAUDE_CODE_USE_BEDROCK=1
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=

# ── Proxy (if needed) ──
# no_proxy=127.0.0.1,localhost

# ── Logging ──
RUST_LOG=info,astra_gateway=debug
