review/
/plans/

*.spec
.mo-session/
budget-app/
.mo-delivery-*.json
# Local cargo config lives here; only audit policy is tracked for CI.
.cargo/*
!.cargo/audit.toml


# Benchmarks (local SWE-bench workspaces, runs, reports)
benchmarks/

# insta-rs runtime artifacts (only the canonical .snap is tracked)
*.snap.new
.insta/

investigation/
tools/
