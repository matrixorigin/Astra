# Local memory / rules (do not commit)
.local/

.astra/

# Kiro project steering is tracked; ignore per-machine state and caches.
.kiro/*
!.kiro/steering/
.kiro/steering/*
!.kiro/steering/project-rules.md

# Docker volumes (local data)
deployment/all-in-one/data/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg
*.egg-info/
.eggs/
dist/
build/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/
*.manifest
.models.yaml*
!.models.yaml.example

# Node
node_modules/
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity
# TypeScript incremental (monorepo-wide; per-package rules may also list this)
*.tsbuildinfo
.eslintcache

# Rust
target/

# Agent tool configs (track project rules, ignore user-local extras)
.cursor/plans/

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

