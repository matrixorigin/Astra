# TrustMem Cloud v1 — Environment Variables
# Copy to .env and fill in required values.

# ─── Required ───────────────────────────────────────────────
TRUSTMEM_MASTER_KEY=          # Admin API key, min 16 chars

# ─── Database (defaults work with bundled MatrixOne) ────────
# TRUSTMEM_DB_HOST=matrixone
# TRUSTMEM_DB_PORT=6001
# TRUSTMEM_DB_USER=root
# TRUSTMEM_DB_PASSWORD=111
# TRUSTMEM_DB_NAME=trustmem

# ─── Embedding ──────────────────────────────────────────────
# Option 1: OpenAI (recommended, no extra build step)
TRUSTMEM_EMBEDDING_PROVIDER=openai
TRUSTMEM_EMBEDDING_MODEL=text-embedding-3-small
TRUSTMEM_EMBEDDING_API_KEY=sk-...
# TRUSTMEM_EMBEDDING_BASE_URL=https://custom-endpoint/v1  # optional, for compatible APIs

# Option 2: Local sentence-transformers (no API key, but requires INSTALL_EXTRAS=local-embedding at build time)
# TRUSTMEM_EMBEDDING_PROVIDER=local
# TRUSTMEM_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─── Ports (host-side) ─────────────────────────────────────
# API_PORT=8100
# MATRIXONE_PORT=6001
# MATRIXONE_DEBUG_PORT=6060   # Uncomment to expose MatrixOne pprof/debug port

# ─── Data Directory ─────────────────────────────────────────
# MATRIXONE_DATA_DIR=./data/matrixone   # default, relative to trustmem_cloud_v1/

# ─── Rate Limits (optional, format: max_requests,window_seconds) ────
# TRUSTMEM_RATE_LIMIT_AUTH_KEYS=20,60       # default: 20/min
# TRUSTMEM_RATE_LIMIT_STORE=300,60          # default: 300/min
# TRUSTMEM_RATE_LIMIT_RETRIEVE=600,60       # default: 600/min
# TRUSTMEM_RATE_LIMIT_CONSOLIDATE=3,3600    # default: 3/hour
# TRUSTMEM_RATE_LIMIT_REFLECT=2,7200        # default: 2/2h
# TRUSTMEM_RATE_LIMIT_DEFAULT=1000,60       # fallback: 1000/min

# ─── Build ──────────────────────────────────────────────────
# For local embedding support in Docker:
# INSTALL_EXTRAS=local-embedding
