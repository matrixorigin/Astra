{
  "name": "evaluate_session",
  "version": "2.0.0",
  "description": "Evaluate agent session performance and provide optimization recommendations",
  "category": "analysis",
  "input_schema": {
    "type": "object",
    "properties": {
      "target_session_id": {
        "type": "string",
        "description": "Session ID to evaluate"
      },
      "objective": {
        "type": "string",
        "enum": ["cost", "accuracy", "latency", "balanced"],
        "description": "Optimization objective (optional)"
      },
      "include_details": {
        "type": "boolean",
        "description": "Include detailed event breakdown",
        "default": false
      }
    },
    "required": ["target_session_id"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "success": {"type": "boolean"},
      "error": {"type": ["string", "null"]},
      "session_id": {"type": ["string", "null"]},
      "total_events": {"type": "integer"},
      "user_queries": {"type": "integer"},
      "llm_calls": {"type": "integer"},
      "tokens": {
        "type": "object",
        "properties": {
          "prompt": {"type": "integer"},
          "completion": {"type": "integer"},
          "total": {"type": "integer"},
          "avg_per_call": {"type": "integer"}
        }
      },
      "skills": {
        "type": "object",
        "properties": {
          "unique": {"type": "integer"},
          "total_calls": {"type": "integer"},
          "breakdown": {"type": "object"}
        }
      },
      "assessment": {
        "type": "object",
        "properties": {
          "token_efficiency": {"type": "string", "enum": ["excellent", "good", "moderate", "needs_improvement"]},
          "tokens_per_query": {"type": "integer"},
          "call_efficiency": {"type": "string", "enum": ["excellent", "good", "moderate", "needs_improvement"]},
          "calls_per_query": {"type": "number"},
          "overall": {"type": "string", "enum": ["good", "needs_improvement"]}
        }
      },
      "optimization": {
        "type": ["object", "null"],
        "properties": {
          "objective": {"type": "string"},
          "scores_before": {"type": "object"},
          "scores_after": {"type": "object"},
          "recommendations": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  },
  "examples": [
    {
      "input": {"target_session_id": "019ca9f1-3dc6-72b3-9813-1f38f7349c53"},
      "output": {
        "success": true,
        "user_queries": 3,
        "llm_calls": 7,
        "tokens": {"total": 42532, "avg_per_call": 6076},
        "assessment": {"token_efficiency": "moderate", "overall": "needs_improvement"}
      }
    },
    {
      "input": {"target_session_id": "019ca9f1-3dc6-72b3-9813-1f38f7349c53", "objective": "cost"},
      "output": {
        "success": true,
        "optimization": {
          "objective": "cost",
          "scores_before": {"cost": 0.60},
          "scores_after": {"cost": 0.85},
          "recommendations": ["Enable aggressive context compaction", "Reduce max history"]
        }
      }
    }
  ]
}
