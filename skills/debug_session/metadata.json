{
  "name": "debug_session",
  "version": "1.0.0",
  "description": "Diagnose stuck, slow, or looping astra sessions using journal and checkpoint data",
  "category": "development",
  "input_schema": {
    "type": "object",
    "properties": {
      "target": {
        "type": "string",
        "description": "Session ID, JSON log file path, or keyword ('this', 'last')"
      },
      "symptom": {
        "type": "string",
        "enum": ["stuck", "slow", "looping", "wrong-tools", "errors", "all"],
        "description": "Primary symptom to diagnose (default: all)"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "root_cause": {
        "type": "string",
        "description": "Primary diagnosis"
      },
      "escalation_level": {
        "type": "string",
        "enum": ["normal", "warning", "critical"],
        "description": "TurnGuard escalation level reached"
      },
      "stall_events": {
        "type": "number",
        "description": "Number of stall detections"
      },
      "correction_effectiveness": {
        "type": "number",
        "description": "Ratio of corrections that were followed (0.0-1.0)"
      },
      "recommended_fix": {
        "type": "string",
        "description": "Specific action to resolve the issue"
      }
    }
  },
  "examples": [
    {
      "input": { "target": "last", "symptom": "stuck" },
      "description": "Diagnose why the most recent session got stuck"
    },
    {
      "input": { "symptom": "slow" },
      "description": "Investigate latency issues in the most recent session"
    }
  ]
}
