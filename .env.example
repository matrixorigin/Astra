# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Database
DATABASE__HOST=localhost
DATABASE__PORT=6001
DATABASE__USER=root
DATABASE__PASSWORD=111
DATABASE__DATABASE=dev_agent
DATABASE__POOL_SIZE=10
DATABASE__MAX_OVERFLOW=20

# LLM
LLM__PROVIDER=openai
LLM__MODEL=gpt-4
LLM__TEMPERATURE=0.7
LLM__MAX_TOKENS=2000
LLM__TIMEOUT=30
LLM__MAX_RETRIES=3

# Security
SECURITY__API_KEY_HEADER=X-API-Key
SECURITY__JWT_ALGORITHM=HS256
SECURITY__JWT_EXPIRATION=3600
SECURITY__RATE_LIMIT_PER_MINUTE=60
SECURITY__ALLOWED_ORIGINS=["*"]

# Monitoring
MONITORING__ENABLE_METRICS=true
MONITORING__ENABLE_TRACING=false
MONITORING__HEALTH_CHECK_INTERVAL=30

# Secrets (DO NOT commit these in production - use secrets manager)
OPENAI_API_KEY=your-openai-key-here
GROQ_API_KEY=your-groq-key-here
GITHUB_TOKEN=your-github-token-here
JWT_SECRET=your-jwt-secret-here
