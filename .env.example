# Environment Configuration

# Service
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true

# Database (MatrixOne)
DATABASE_HOST=localhost
DATABASE_PORT=6001
DATABASE_USER=dump
DATABASE_PASSWORD=111
DATABASE_TENANT=agent_platform
DATABASE_NAME=agent_engine

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Token Encryption (REQUIRED)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=CHANGE_ME_IN_PRODUCTION

# Security
BCRYPT_ROUNDS=12

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Logging
LOG_LEVEL=INFO

# Embedding
# Provider: local (sentence-transformers), openai (any OpenAI-compatible API), mock
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=0  # 0 = auto-infer from model name (requires model in KNOWN_DIMENSIONS)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# ── TrustMem Cloud v1 ────────────────────────────────────────────────
# All prefixed with TRUSTMEM_ to avoid collision with core settings.

# Database
TRUSTMEM_DB_HOST=localhost
TRUSTMEM_DB_PORT=6001
TRUSTMEM_DB_USER=root
TRUSTMEM_DB_PASSWORD=111
TRUSTMEM_DB_NAME=trustmem

# Embedding (same options as core: local / openai / mock)
TRUSTMEM_EMBEDDING_PROVIDER=local
TRUSTMEM_EMBEDDING_MODEL=all-MiniLM-L6-v2
TRUSTMEM_EMBEDDING_DIM=0
TRUSTMEM_EMBEDDING_API_KEY=
TRUSTMEM_EMBEDDING_BASE_URL=

# Auth
TRUSTMEM_MASTER_KEY=

# Limits
TRUSTMEM_SNAPSHOT_LIMIT=100
