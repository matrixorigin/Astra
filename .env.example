# mo-dev-agent Environment Configuration
# Copy this file to .env and customize for your local environment

# ============================================================================
# MatrixOne Database Configuration
# ============================================================================
MATRIXONE_HOST=localhost
MATRIXONE_PORT=6001
MATRIXONE_USER=root
MATRIXONE_PASSWORD=111
MATRIXONE_DATABASE=dev_agent

# ============================================================================
# Redis Configuration (for future use)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================================
# Application Configuration
# ============================================================================
# Environment: development, staging, production
APP_ENV=development

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG

# ============================================================================
# Docker Configuration (for docker-compose)
# ============================================================================
# User ID and Group ID (run `id -u` and `id -g` to get your values)
DOCKER_UID=1000
DOCKER_GID=1000

# MatrixOne Docker image
MATRIXONE_IMAGE=matrixorigin/matrixone:latest

# ============================================================================
# Security (DO NOT commit actual secrets)
# ============================================================================
# Secret key for encryption (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-here-change-in-production
