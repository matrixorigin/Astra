# Environment Configuration

# Service
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true

# Database (MatrixOne) — read by astra_core::AppSettings (see rust/crates/core/src/config.rs)
# Must match a database you create in MatrixOne (CI / test.yml use astra_runtime).
MATRIXONE_HOST=localhost
MATRIXONE_PORT=6001
MATRIXONE_USER=root
MATRIXONE_PASSWORD=111
MATRIXONE_DATABASE=astra_runtime

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Token Encryption (REQUIRED)
# Generate automatically with: bash scripts/dev/init.sh
TOKEN_ENCRYPTION_KEY=CHANGE_ME_IN_PRODUCTION

# Security
BCRYPT_ROUNDS=12

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Logging
LOG_LEVEL=INFO

# Embedding
# Provider: local (sentence-transformers), openai (any OpenAI-compatible API), mock
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=0  # 0 = auto-infer from model name (requires model in KNOWN_DIMENSIONS)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# ── Memoria ────────────────────────────────────────────────
# All prefixed with MEMORIA_ to avoid collision with core settings.

# Database
MEMORIA_DB_HOST=localhost
MEMORIA_DB_PORT=6001
MEMORIA_DB_USER=root
MEMORIA_DB_PASSWORD=111
MEMORIA_DB_NAME=memoria

# Embedding (same options as core: local / openai / mock)
# ── Memoria Service Configuration ─────────────────────────
# For mo-dev-agent to connect to Memoria service
MEMORIA_BASE_URL=http://localhost:8100
MEMORIA_MASTER_KEY=test-master-key-for-docker-compose
MEMORIA_API_KEY=

# ── Memoria Standalone Service Configuration ───────────────
# Database connection for standalone Memoria service
MEMORIA_DB_HOST=localhost
MEMORIA_DB_PORT=6001
MEMORIA_DB_USER=root
MEMORIA_DB_PASSWORD=111
MEMORIA_DB_NAME=memoria

# Embedding configuration for standalone Memoria service
MEMORIA_EMBEDDING_PROVIDER=local
MEMORIA_EMBEDDING_MODEL=all-MiniLM-L6-v2
MEMORIA_EMBEDDING_DIM=0
MEMORIA_EMBEDDING_API_KEY=
MEMORIA_EMBEDDING_BASE_URL=

# Memoria service limits
MEMORIA_SNAPSHOT_LIMIT=100

# ── Test Configuration ─────────────────────────────────────
# Test-specific overrides (used by pytest)
TEST_MEMORIA_BASE_URL=http://localhost:8100
TEST_MEMORIA_MASTER_KEY=test-master-key-for-docker-compose

# ── Edge / thin client (optional) ───────────────────────────
# Used by astra CLI chat (registry + heartbeat) and server-side sync wiring.
# HTTP callbacks use header X-Astra-Edge-Id (see docs/design/multi-agent-cloud-runtime.md §5.5).
#
# ASTRA_EDGE_REGISTRY — unset = register + heartbeat enabled; set to 0, false, or off to disable entirely.
# ASTRA_EDGE_HEARTBEAT_SECS — seconds between heartbeats (default 120); set to 0 to skip background heartbeat.
# ASTRA_EDGE_EXECUTOR_ID — stable id for this CLI process (default: random edge-{uuid} per process).
# ASTRA_EDGE_AGENT_ID — logical edge id for MatrixCloudRuntime / task lease paths (default: astra-server).
#ASTRA_EDGE_REGISTRY=
#ASTRA_EDGE_HEARTBEAT_SECS=
#ASTRA_EDGE_EXECUTOR_ID=
#ASTRA_EDGE_AGENT_ID=
