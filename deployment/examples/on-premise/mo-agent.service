[Unit]
Description=mo-agent API Server
After=network.target matrixone.service redis.service
Wants=matrixone.service redis.service

[Service]
Type=simple
User=mo-agent
Group=mo-agent
WorkingDirectory=/opt/mo-agent
EnvironmentFile=/opt/mo-agent/.env
Environment=RUST_API_ADDR=0.0.0.0:8000
ExecStart=/usr/local/bin/mo-agent-rs-api-shell
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/mo-agent/logs

[Install]
WantedBy=multi-user.target
