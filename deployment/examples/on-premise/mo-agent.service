[Unit]
Description=astra API Server
After=network.target matrixone.service
Wants=matrixone.service

[Service]
Type=simple
User=astra
Group=astra
WorkingDirectory=/opt/astra
EnvironmentFile=/opt/astra/.env
Environment=ASTRA_API_HOST=0.0.0.0
Environment=ASTRA_API_PORT=8000
ExecStart=/usr/local/bin/astra-rs-api-shell
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/astra/logs

[Install]
WantedBy=multi-user.target
