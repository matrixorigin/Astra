# astra-engine all-in-one Docker deployment environment
#
# Usage:
#   make stack-env
#   Edit required embedding configuration below.
#   make stack-up
#
# `make stack-env` generates stack secrets automatically. If you use plain
# docker compose, fill these values yourself.
#
# Generate secrets manually:
#   openssl rand -hex 32

# --- Docker images -----------------------------------------------------------
ASTRA_IMAGE=matrixorigin/astra:latest
MEMORIA_IMAGE=matrixorigin/memoria:latest
MATRIXONE_IMAGE=matrixorigin/matrixone:4.0.0-rc3

# --- Host ports --------------------------------------------------------------
# ASTRA_API_PORT controls the host-facing published port; the API container
# still listens on 17001 internally.
ASTRA_API_PORT=17001
MEMORIA_PORT=8100
MATRIXONE_PORT=26001
MATRIXONE_DEBUG_HTTP_PORT=26060

# --- MatrixOne ---------------------------------------------------------------
MATRIXONE_USER=root
MATRIXONE_PASSWORD=111
ASTRA_DATABASE=astra_runtime
#ASTRA_DATABASE_PREFIX=
ASTRA_AUTO_CREATE_DATABASE=1
MATRIXONE_DATA_VOLUME=astra-matrixone-data

# --- API server --------------------------------------------------------------
# Do not enable insecure defaults outside local throwaway deployments.
ASTRA_ALLOW_INSECURE_DEFAULTS=0
ASTRA_CORS_ORIGINS=*
ASTRA_RUST_LOG=info

ASTRA_JWT_SECRET=
ASTRA_JWT_ALGORITHM=HS256
ASTRA_JWT_ACCESS_TTL_MINUTES=60
ASTRA_JWT_REFRESH_TTL_DAYS=7
ASTRA_TOKEN_ENCRYPTION_KEY=
ASTRA_BRIDGE_SECRET=

# Harness snapshots remain available in memory and over SSE for active runs.
# Durable DB history follows runtime.toml trace config (`trace.profile = "dev"`
# or the `harness_snapshots` trace category).

# Provider admission is disabled by default. Enable this for load tests or
# deployments where local run slots can exceed the external LLM quota.
#ASTRA_LLM_PROVIDER_ADMISSION_MODE=db_fixed_window
#ASTRA_LLM_PROVIDER_ADMISSION_RPM=60
#ASTRA_LLM_PROVIDER_ADMISSION_TPM=
#ASTRA_LLM_PROVIDER_ADMISSION_SCOPE=provider
#ASTRA_LLM_PROVIDER_ADMISSION_BURST=1

# Run admission waits before returning structured `run_admission_timeout`.
# Increase only when clients are expected to queue behind run slots.
#ASTRA_RUN_ADMISSION_TIMEOUT_SECS=30

# Auxiliary LLM calls are capacity-aware by default when provider admission is
# enabled. Per-purpose policies override the global one.
#ASTRA_AUX_LLM_POLICY=capacity_aware
#ASTRA_TURN_INTENT_JUDGE_POLICY=capacity_aware
#ASTRA_FACTUAL_RETRY_JUDGE_POLICY=capacity_aware
#ASTRA_PRE_TURN_COMPACTION_LLM_POLICY=capacity_aware

# Server-loop Memoria observer defaults to async best-effort. Use inline only
# when observer completion must be part of terminal finalization; use disabled
# to exclude this optional path from pressure tests.
#ASTRA_TURN_OBSERVER_MODE=async
#ASTRA_TURN_OBSERVER_ASYNC_CONCURRENCY=4

# Post-loop memory cleanup defaults to async best-effort so optional Memoria
# final flush/governance does not hold run admission slots.
#ASTRA_POST_LOOP_MEMORY_CLEANUP_MODE=async
#ASTRA_POST_LOOP_MEMORY_CLEANUP_CONCURRENCY=4
#ASTRA_SESSION_MEMORY_POST_LOOP_DRAIN_TIMEOUT_MS=1000

# --- Memoria -----------------------------------------------------------------
# API containers use http://memoria:8100 internally.
MEMORIA_MASTER_KEY=
MEMORIA_DB_NAME=memoria

# OpenAI-compatible embedding endpoint. These two values are required.
MEMORIA_EMBEDDING_PROVIDER=openai
MEMORIA_EMBEDDING_MODEL=BAAI/bge-m3
MEMORIA_EMBEDDING_DIM=1024
MEMORIA_EMBEDDING_API_KEY=
MEMORIA_EMBEDDING_BASE_URL=
MEMORIA_EMBEDDING_ENDPOINTS=
MEMORIA_RUST_LOG=info

# Optional Memoria LLM/governance settings.
#MEMORIA_LLM_API_KEY=
#MEMORIA_LLM_BASE_URL=
#MEMORIA_LLM_MODEL=gpt-4o-mini
#MEMORIA_GOVERNANCE_ENABLED=false

# --- Optional integrations ---------------------------------------------------
#GITHUB_TOKEN=
#ASTRA_EDGE_REGISTRY=
#ASTRA_EDGE_HEARTBEAT_SECS=120
#ASTRA_EDGE_EXECUTOR_ID=
#ASTRA_EDGE_AGENT_ID=
