# astra Environment Configuration Template
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Then edit .env with your actual configuration.

# ─── Security (REQUIRED) ──────────────────────────────────────
# Generate or refresh with: bash scripts/dev/init.sh

TOKEN_ENCRYPTION_KEY=
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── LLM Configuration (REQUIRED) ─────────────────────────────

# Provider: openai, anthropic, azure, etc.
LLM_PROVIDER=openai

# Model name
LLM_MODEL=gpt-4

# API Keys (set the one you're using)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# LLM Settings
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.7

# ─── Database (MatrixOne) ─────────────────────────────────────

MATRIXONE_HOST=localhost
MATRIXONE_PORT=6001
MATRIXONE_USER=root
MATRIXONE_PASSWORD=111
MATRIXONE_DATABASE=astra

# Connection Pool
MATRIXONE_POOL_SIZE=10
MATRIXONE_MAX_OVERFLOW=5
MATRIXONE_POOL_TIMEOUT=30
MATRIXONE_POOL_RECYCLE=3600

# ─── Redis ────────────────────────────────────────────────────

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_TIMEOUT=5

# ─── API Server ───────────────────────────────────────────────

API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_RELOAD=true

# Logging
LOG_LEVEL=info
LOG_FORMAT=text
LOG_OUTPUT=stdout

# CORS
CORS_ORIGINS=*
CORS_CREDENTIALS=true
CORS_METHODS=*
CORS_HEADERS=*

# ─── Features ─────────────────────────────────────────────────

# Metrics
ENABLE_METRICS=false
METRICS_PORT=9090

# Tracing
ENABLE_TRACING=false
TRACING_ENDPOINT=

# Rate Limiting
ENABLE_RATE_LIMITING=true
RATE_LIMIT_PER_MINUTE=60

# ─── GitHub Integration (Optional) ────────────────────────────

GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_TIMEOUT=30

# ─── Docker Images ────────────────────────────────────────────

MATRIXONE_IMAGE=matrixorigin/matrixone:latest
VERSION=latest

# ─── Production Settings (for docker-compose.prod.yml) ───────

# Database Pool (Production)
# MATRIXONE_POOL_SIZE=20
# MATRIXONE_MAX_OVERFLOW=10

# Redis Pool (Production)
# REDIS_POOL_SIZE=50

# API Workers (Production)
# API_WORKERS=4
# API_RELOAD=false
# LOG_FORMAT=json

# Rate Limiting (Production)
# RATE_LIMIT_PER_MINUTE=120

# Metrics (Production)
# ENABLE_METRICS=true

# ─── Edge / thin client (optional) ────────────────────────────
# HTTP callbacks: X-Astra-Edge-Id. See docs/design/multi-agent-cloud-runtime.md §5.5.
#
# ASTRA_EDGE_REGISTRY — unset = register + heartbeat; 0 / false / off = disable.
# ASTRA_EDGE_HEARTBEAT_SECS — default 120; 0 = no background heartbeat.
# ASTRA_EDGE_EXECUTOR_ID — CLI process id (default random per process).
# ASTRA_EDGE_AGENT_ID — server sync / lease id (default astra-server).
#ASTRA_EDGE_REGISTRY=
#ASTRA_EDGE_HEARTBEAT_SECS=
#ASTRA_EDGE_EXECUTOR_ID=
#ASTRA_EDGE_AGENT_ID=
