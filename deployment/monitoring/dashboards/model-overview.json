{
  "title": "Astra Model Execution",
  "tags": ["astra", "model"],
  "timezone": "browser",
  "panels": [
    {
      "title": "Main Model Attempt Rate",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (attempt, outcome) (rate(astra_llm_main_attempts_total{phase=\"call\"}[5m]))",
          "legendFormat": "{{attempt}} · {{outcome}}"
        }
      ]
    },
    {
      "title": "Provider-Reported Tokens (Admission Calibration)",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(astra_llm_provider_admission_calibration_actual_tokens_total{outcome!=\"missing_usage\"}[5m]))",
          "legendFormat": "observed tokens/s"
        }
      ]
    }
  ],
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" }
}
