{
    "title": "Astra Runtime Capacity",
    "tags": ["astra", "runtime", "capacity"],
    "timezone": "browser",
    "refresh": "10s",
    "time": {"from": "now-1h", "to": "now"},
    "panels": [
      {
        "title": "Rollout Gate",
        "type": "stat",
        "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "astra_capacity_rollout_allowed",
            "legendFormat": "allowed"
          }
        ]
      },
      {
        "title": "Rollout Risks",
        "type": "graph",
        "gridPos": {"h": 5, "w": 18, "x": 6, "y": 0},
        "targets": [
          {
            "expr": "astra_capacity_rollout_risk",
            "legendFormat": "{{risk}}"
          }
        ]
      },
      {
        "title": "Configured Capacity",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
        "targets": [
          {
            "expr": "astra_capacity_run_slots_total",
            "legendFormat": "run slots"
          },
          {
            "expr": "astra_capacity_tool_slots_total",
            "legendFormat": "tool slots"
          },
          {
            "expr": "astra_capacity_endpoint_rpc_slots_total",
            "legendFormat": "endpoint RPC slots"
          }
        ]
      },
      {
        "title": "Control Poll QPS Estimate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
        "targets": [
          {
            "expr": "astra_capacity_control_poll_qps_estimate",
            "legendFormat": "estimated DB poll QPS"
          }
        ]
      },
      {
        "title": "Run Admission Outcomes",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
        "targets": [
          {
            "expr": "rate(astra_run_admission_attempts_total[5m])",
            "legendFormat": "{{outcome}}"
          }
        ]
      },
      {
        "title": "Run Admission Mean Wait",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
        "targets": [
          {
            "expr": "rate(astra_run_admission_wait_ms_total[5m]) / clamp_min(rate(astra_run_admission_attempts_total[5m]), 1)",
            "legendFormat": "{{outcome}} mean wait ms"
          }
        ]
      },
      {
        "title": "Tool Execution Admission",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 21},
        "targets": [
          {
            "expr": "rate(astra_tool_execution_attempts_total[5m])",
            "legendFormat": "{{outcome}}"
          }
        ]
      },
      {
        "title": "Tool Execution Mean Wait",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 21},
        "targets": [
          {
            "expr": "rate(astra_tool_execution_wait_ms_total[5m]) / clamp_min(rate(astra_tool_execution_attempts_total[5m]), 1)",
            "legendFormat": "{{outcome}} mean wait ms"
          }
        ]
      },
      {
        "title": "Provider Admission Attempts",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 29},
        "targets": [
          {
            "expr": "rate(astra_llm_provider_admission_attempts_total[5m])",
            "legendFormat": "{{mode}} {{scope}} {{outcome}}"
          }
        ]
      },
      {
        "title": "Provider Admission Tokens",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 29},
        "targets": [
          {
            "expr": "rate(astra_llm_provider_admission_tokens_total[5m])",
            "legendFormat": "{{mode}} {{scope}} {{outcome}}"
          }
        ]
      },
      {
        "title": "Provider Cooldown State",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 37},
        "targets": [
          {
            "expr": "astra_llm_provider_rate_limit_state",
            "legendFormat": "{{model}} {{state}}"
          },
          {
            "expr": "astra_llm_provider_rate_limit_cooldown_remaining_ms",
            "legendFormat": "{{model}} remaining ms"
          }
        ]
      },
      {
        "title": "Provider Rate Limit Errors",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 37},
        "targets": [
          {
            "expr": "rate(astra_llm_provider_rate_limit_errors_total[5m])",
            "legendFormat": "{{model}} {{status}}"
          },
          {
            "expr": "rate(astra_llm_provider_rate_limit_cooldowns_total[5m])",
            "legendFormat": "{{model}} cooldowns"
          },
          {
            "expr": "rate(astra_llm_provider_rate_limit_fallbacks_total[5m])",
            "legendFormat": "{{model}} fallbacks"
          }
        ]
      },
      {
        "title": "Provider Admission Calibration",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 45},
        "targets": [
          {
            "expr": "rate(astra_llm_provider_admission_calibration_samples_total[5m])",
            "legendFormat": "{{outcome}} samples"
          },
          {
            "expr": "rate(astra_llm_provider_admission_calibration_abs_error_tokens_total[5m])",
            "legendFormat": "{{outcome}} abs token error"
          }
        ]
      },
      {
        "title": "Run Control And Recovery",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 45},
        "targets": [
          {
            "expr": "rate(astra_run_control_poll_attempts_total[5m])",
            "legendFormat": "{{operation}} {{outcome}}"
          },
          {
            "expr": "rate(astra_run_control_poll_errors_total[5m])",
            "legendFormat": "{{operation}} {{class}}"
          },
          {
            "expr": "rate(astra_run_recovery_scans_total[5m])",
            "legendFormat": "recovery scan {{outcome}}"
          },
          {
            "expr": "rate(astra_run_recovery_runs_total[5m])",
            "legendFormat": "recovery {{action}} {{outcome}}"
          }
        ]
      },
      {
        "title": "Durable Run Event Writes",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 53},
        "targets": [
          {
            "expr": "rate(astra_durable_run_event_batches_total[5m])",
            "legendFormat": "{{path}} {{outcome}} compacted={{compacted}}"
          },
          {
            "expr": "rate(astra_durable_run_event_rows_total[5m])",
            "legendFormat": "{{path}} rows compacted={{compacted}}"
          }
        ]
      },
      {
        "title": "Durable Run Event Bytes",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 53},
        "targets": [
          {
            "expr": "rate(astra_durable_run_event_bytes_total[5m])",
            "legendFormat": "{{path}} {{outcome}} compacted={{compacted}}"
          }
        ]
      },
      {
        "title": "Edge Dispatch Backlog",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 61},
        "targets": [
          {
            "expr": "astra_edge_dispatch_pending_rows",
            "legendFormat": "pending rows"
          },
          {
            "expr": "astra_edge_dispatch_dispatched_rows",
            "legendFormat": "dispatched rows"
          },
          {
            "expr": "astra_edge_dispatch_oldest_pending_age_ms",
            "legendFormat": "oldest pending ms"
          },
          {
            "expr": "astra_edge_dispatch_oldest_dispatched_age_ms",
            "legendFormat": "oldest dispatched ms"
          }
        ]
      },
      {
        "title": "Edge Dispatch Outcomes",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 61},
        "targets": [
          {
            "expr": "rate(astra_edge_dispatch_claimed_total[5m])",
            "legendFormat": "claimed"
          },
          {
            "expr": "rate(astra_edge_dispatch_deliver_hits_total[5m])",
            "legendFormat": "deliver hits"
          },
          {
            "expr": "rate(astra_edge_dispatch_deliver_misses_total[5m])",
            "legendFormat": "deliver misses"
          },
          {
            "expr": "rate(astra_edge_dispatch_cleanup_expired_total[5m])",
            "legendFormat": "cleanup expired"
          },
          {
            "expr": "rate(astra_edge_dispatch_cleanup_deleted_total[5m])",
            "legendFormat": "cleanup deleted"
          },
          {
            "expr": "rate(astra_edge_dispatch_wait_result_timeouts_total[5m])",
            "legendFormat": "wait_result timeout"
          }
        ]
      },
      {
        "title": "Edge Dispatch Mean Latency",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 69},
        "targets": [
          {
            "expr": "rate(astra_edge_dispatch_claim_wait_us_total[5m]) / clamp_min(rate(astra_edge_dispatch_claim_wait_count[5m]), 1) / 1000",
            "legendFormat": "claim wait ms"
          },
          {
            "expr": "rate(astra_edge_dispatch_deliver_update_us_total[5m]) / clamp_min(rate(astra_edge_dispatch_deliver_update_count[5m]), 1) / 1000",
            "legendFormat": "deliver update ms"
          }
        ]
      },
      {
        "title": "Interaction Durable Journal",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 77},
        "targets": [
          {
            "expr": "rate(astra_interaction_approval_lookup_total[5m])",
            "legendFormat": "approval lookup {{event}} {{outcome}}"
          },
          {
            "expr": "rate(astra_interaction_approval_resolution_total[5m])",
            "legendFormat": "approval resolution {{outcome}}"
          },
          {
            "expr": "rate(astra_interaction_ask_user_journal_lookup_total[5m])",
            "legendFormat": "ask_user lookup {{outcome}}"
          },
          {
            "expr": "rate(astra_interaction_ask_user_journal_write_total[5m])",
            "legendFormat": "ask_user write {{event}} {{outcome}}"
          }
        ]
      },
      {
        "title": "Interaction Wait And Cleanup",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 77},
        "targets": [
          {
            "expr": "rate(astra_interaction_ask_user_wait_total[5m])",
            "legendFormat": "ask_user wait {{source}} {{outcome}}"
          },
          {
            "expr": "rate(astra_interaction_ask_user_ledger_cleanup_total[5m])",
            "legendFormat": "ask_user cleanup {{outcome}}"
          }
        ]
      },
      {
        "title": "Memory Sidecar Observer",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 85},
        "targets": [
          {
            "expr": "rate(astra_turn_observer_dispatches_total[5m])",
            "legendFormat": "dispatch {{mode}} {{outcome}}"
          },
          {
            "expr": "rate(astra_turn_observer_runs_total[5m])",
            "legendFormat": "run {{mode}} {{outcome}}"
          }
        ]
      },
      {
        "title": "Post-loop Memory Cleanup",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 85},
        "targets": [
          {
            "expr": "rate(astra_post_loop_memory_cleanup_dispatches_total[5m])",
            "legendFormat": "dispatch {{mode}} {{outcome}}"
          },
          {
            "expr": "rate(astra_post_loop_memory_cleanup_workers_total[5m])",
            "legendFormat": "worker {{outcome}}"
          },
          {
            "expr": "rate(astra_session_memory_post_loop_drains_total[5m])",
            "legendFormat": "drain {{outcome}}"
          }
        ]
      },
      {
        "title": "Event Ingestion Backpressure",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 93},
        "targets": [
          {
            "expr": "rate(astra_event_ingestion_enqueue_overflows_total[5m])",
            "legendFormat": "enqueue overflows"
          },
          {
            "expr": "rate(astra_event_ingestion_events_dropped_before_acceptance_total[5m])",
            "legendFormat": "dropped before acceptance"
          },
          {
            "expr": "rate(astra_event_ingestion_events_dropped_before_acceptance_by_priority_total[5m])",
            "legendFormat": "{{priority}} drops before acceptance"
          }
        ]
      },
      {
        "title": "Event Ingestion Flush Health",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 93},
        "targets": [
          {
            "expr": "rate(astra_event_ingestion_events_received_total[5m])",
            "legendFormat": "received"
          },
          {
            "expr": "rate(astra_event_ingestion_events_flushed_total[5m])",
            "legendFormat": "flushed"
          },
          {
            "expr": "rate(astra_event_ingestion_events_dropped_permanent_total[5m])",
            "legendFormat": "permanent drops"
          },
          {
            "expr": "rate(astra_event_ingestion_errors_total[5m])",
            "legendFormat": "errors"
          }
        ]
      }
    ]
}
