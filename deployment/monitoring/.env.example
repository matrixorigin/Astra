# Copy this file to .env before starting the monitoring stack.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Dashboards bind to loopback by default. Change these only when access is
# protected by an authenticated reverse proxy or equivalent network controls.
PROMETHEUS_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9091
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000
