* text=auto

# Keep source, configuration, and executable scripts consistent across platforms.
*.bash text eol=lf
*.cff text eol=lf
*.js text eol=lf
*.json text eol=lf
*.jsx text eol=lf
*.lock text eol=lf
*.md text eol=lf
*.rs text eol=lf
*.sh text eol=lf
*.svg text eol=lf
*.toml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
Dockerfile* text eol=lf
Makefile text eol=lf

# Preserve binary assets without text normalization.
*.gif binary
*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
