{
  "canonical_sorted_args": {
    "raw": "{\"b\":2,\"a\":1}",
    "expected": "{\"a\":1,\"b\":2}"
  },
  "canonical_nested_args": {
    "raw": "{\"b\":{\"z\":2,\"a\":1},\"a\":[3,2,1]}",
    "expected": "{\"a\":[3,2,1],\"b\":{\"a\":1,\"z\":2}}"
  },
  "canonical_invalid_args": {
    "raw": "{\"a\":",
    "expected": "{\"a\":"
  },
  "signature_multiple_tools": {
    "tool_calls": [
      {
        "function": {
          "name": "read_file",
          "arguments": "{\"path\":\"a.py\"}"
        }
      },
      {
        "function": {
          "name": "bash",
          "arguments": "{\"cwd\":\"/tmp\",\"cmd\":\"ls\"}"
        }
      }
    ],
    "expected": [
      "bash:{\"cmd\":\"ls\",\"cwd\":\"/tmp\"}",
      "read_file:{\"path\":\"a.py\"}"
    ]
  },
  "record_trim_window": {
    "rounds": [
      [
        {
          "function": {
            "name": "tool_one",
            "arguments": "{\"x\":1}"
          }
        }
      ],
      [
        {
          "function": {
            "name": "tool_two",
            "arguments": "{\"x\":2}"
          }
        }
      ],
      [
        {
          "function": {
            "name": "tool_three",
            "arguments": "{\"x\":3}"
          }
        }
      ],
      [
        {
          "function": {
            "name": "tool_four",
            "arguments": "{\"x\":4}"
          }
        }
      ]
    ],
    "expected": [
      ["tool_two:{\"x\":2}"],
      ["tool_three:{\"x\":3}"],
      ["tool_four:{\"x\":4}"]
    ]
  },
  "record_empty_clears": {
    "initial": [
      ["tool_one:{\"x\":1}"],
      ["tool_one:{\"x\":1}"]
    ],
    "tool_calls": [],
    "expected": []
  },
  "detect_true": {
    "tool_sigs": [
      ["read_file:{\"path\":\"a.py\"}"],
      ["read_file:{\"path\":\"a.py\"}"],
      ["read_file:{\"path\":\"a.py\"}"]
    ],
    "expected": true
  },
  "detect_false_below_window": {
    "tool_sigs": [
      ["read_file:{\"path\":\"a.py\"}"],
      ["read_file:{\"path\":\"a.py\"}"]
    ],
    "expected": false
  },
  "detect_false_mixed": {
    "tool_sigs": [
      ["read_file:{\"path\":\"a.py\"}"],
      ["read_file:{\"path\":\"b.py\"}"],
      ["read_file:{\"path\":\"a.py\"}"]
    ],
    "expected": false
  }
}
