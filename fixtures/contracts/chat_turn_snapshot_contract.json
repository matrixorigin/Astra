{
  "cases": [
    {
      "name": "non_tool_messages_unchanged",
      "history": [
        {"role": "system", "content": "sys"},
        {"role": "user", "content": "hello"},
        {"role": "assistant", "content": "answer"}
      ],
      "tool_content_limit": 5,
      "expected": [
        {"role": "system", "content": "sys"},
        {"role": "user", "content": "hello"},
        {"role": "assistant", "content": "answer"}
      ]
    },
    {
      "name": "tool_messages_truncated_but_structure_preserved",
      "history": [
        {"role": "assistant", "content": "", "tool_calls": [{"id": "tc1"}]},
        {"role": "tool", "tool_call_id": "tc1", "content": "abcdefghijk"},
        {"role": "tool", "tool_call_id": "tc2", "content": "short"}
      ],
      "tool_content_limit": 5,
      "expected": [
        {"role": "assistant", "content": "", "tool_calls": [{"id": "tc1"}]},
        {"role": "tool", "tool_call_id": "tc1", "content": "abcde [truncated]"},
        {"role": "tool", "tool_call_id": "tc2", "content": "short"}
      ]
    }
  ]
}
