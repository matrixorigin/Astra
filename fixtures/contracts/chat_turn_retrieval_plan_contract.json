        "recent_messages": [
          {
            "role": "assistant",
            "content": "",
            "tool_calls": [
              {"id": "tc1", "type": "function", "function": {"name": "tool_tc1", "arguments": "{}"}}
            ]
          },
          {"role": "tool", "tool_call_id": "tc1", "content": "result1"},
          {"role": "assistant", "content": "a1"},
          {"role": "user", "content": "q2"}
        ],
        "user_query": "latest query"
      }
