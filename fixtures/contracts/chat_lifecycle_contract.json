{
  "auth_error": {
    "status": 401,
    "json": {
      "detail": "Not authenticated"
    }
  },
  "create_run_auto_session": {
    "request": {
      "message": "summarize the last run"
    },
    "status": 200,
    "json": {
      "session_id": "contract-created-session-1",
      "run_id": "contract-run-auto",
      "status": "pending",
      "explain": null
    }
  },
  "create_run_existing_session": {
    "request": {
      "session_id": "contract-existing-session",
      "message": "continue the current task"
    },
    "status": 200,
    "json": {
      "session_id": "contract-existing-session",
      "run_id": "contract-run-existing",
      "status": "pending",
      "explain": null
    }
  },
  "create_run_missing_session": {
    "request": {
      "session_id": "contract-missing-session",
      "message": "continue"
    },
    "status": 404,
    "json": {
      "detail": "Session not found"
    }
  },
  "stream_chat_success": {
    "request": {
      "message": "stream the answer"
    },
    "status": 200,
    "headers": {
      "cache-control": "no-cache",
      "connection": "keep-alive",
      "x-accel-buffering": "no"
    },
    "events": [
      {
        "type": "session_info",
        "session_id": "contract-created-session-1",
        "run_id": "contract-run-stream"
      },
      {
        "type": "run_started"
      },
      {
        "type": "text_delta",
        "content": "partial reply"
      },
      {
        "type": "text_done",
        "full_text": "partial reply complete"
      },
      {
        "type": "run_finished"
      }
    ]
  },
  "stream_chat_missing_session": {
    "request": {
      "session_id": "contract-missing-session",
      "message": "stream the answer"
    },
    "status": 200,
    "headers": {
      "cache-control": "no-cache",
      "connection": "keep-alive",
      "x-accel-buffering": "no"
    },
    "events": [
      {
        "type": "error",
        "message": "Session not found",
        "code": "NOT_FOUND",
        "retryable": false
      }
    ]
  },
  "get_run_status_success": {
    "status": 200,
    "json": {
      "run_id": "contract-run-live",
      "session_id": "contract-existing-session",
      "status": "pending",
      "waiting_for": null,
      "events_count": 4
    }
  },
  "get_run_status_not_found": {
    "status": 404,
    "json": {
      "detail": "Run not found"
    }
  },
  "get_run_status_forbidden": {
    "status": 403,
    "json": {
      "detail": "Not authorized to view this run"
    }
  },
  "stream_run_success": {
    "status": 200,
    "headers": {
      "cache-control": "no-cache",
      "connection": "keep-alive",
      "x-accel-buffering": "no"
    },
    "events": [
      {
        "event_type": "text_delta",
        "data": {
          "chunk": "partial reply"
        },
        "run_id": "contract-run-live"
      },
      {
        "event_type": "text_done",
        "data": {
          "full_text": "partial reply complete"
        },
        "run_id": "contract-run-live"
      },
      {
        "event_type": "run_finished",
        "data": {},
        "run_id": "contract-run-live"
      }
    ]
  },
  "stream_run_not_found": {
    "status": 200,
    "headers": {
      "cache-control": "no-cache",
      "connection": "keep-alive",
      "x-accel-buffering": "no"
    },
    "events": [
      {
        "type": "error",
        "message": "Run not found",
        "code": "NOT_FOUND",
        "retryable": false
      }
    ]
  },
  "stream_run_forbidden": {
    "status": 200,
    "headers": {
      "cache-control": "no-cache",
      "connection": "keep-alive",
      "x-accel-buffering": "no"
    },
    "events": [
      {
        "type": "error",
        "message": "Not authorized to view this run",
        "code": "AUTH_ERROR",
        "retryable": false
      }
    ]
  },
  "cancel_run_success": {
    "status": 200,
    "json": {
      "run_id": "contract-run-cancellable",
      "status": "cancelled"
    }
  },
  "cancel_run_finished": {
    "status": 409,
    "json": {
      "detail": "Run already finished"
    }
  },
  "cancel_run_forbidden": {
    "status": 403,
    "json": {
      "detail": "Not authorized to cancel this run"
    }
  }
}
