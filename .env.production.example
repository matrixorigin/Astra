# Production Environment Configuration
# Copy this to .env.production and update with real values

ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=WARNING
LOG_FORMAT=json

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database (use production database)
DATABASE__HOST=prod-db.example.com
DATABASE__PORT=6001
DATABASE__USER=prod_user
DATABASE__PASSWORD=<USE_SECRETS_MANAGER>
DATABASE__DATABASE=mo_dev_agent_prod
DATABASE__POOL_SIZE=20
DATABASE__MAX_OVERFLOW=40

# LLM
LLM__PROVIDER=openai
LLM__MODEL=gpt-4
LLM__TEMPERATURE=0.7
LLM__MAX_TOKENS=2000
LLM__TIMEOUT=30
LLM__MAX_RETRIES=3

# Security (CRITICAL: Update these!)
SECURITY__API_KEY_HEADER=X-API-Key
SECURITY__JWT_ALGORITHM=HS256
SECURITY__JWT_EXPIRATION=3600
SECURITY__RATE_LIMIT_PER_MINUTE=100
SECURITY__ALLOWED_ORIGINS=["https://app.example.com"]

# Monitoring
MONITORING__ENABLE_METRICS=true
MONITORING__ENABLE_TRACING=true
MONITORING__HEALTH_CHECK_INTERVAL=30

# Secrets (USE AWS SECRETS MANAGER OR VAULT IN PRODUCTION!)
OPENAI_API_KEY=<USE_SECRETS_MANAGER>
GROQ_API_KEY=<USE_SECRETS_MANAGER>
GITHUB_TOKEN=<USE_SECRETS_MANAGER>
JWT_SECRET=<USE_SECRETS_MANAGER>
