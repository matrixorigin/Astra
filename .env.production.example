# Astra production environment template
# NEVER set ASTRA_ALLOW_INSECURE_DEFAULTS=1 in production.

# ── Published images / ingress ─────────────────────────────────────────────
# Pin an immutable release tag or digest. Do not deploy `latest` in production.
ASTRA_IMAGE=matrixorigin/astra:0.1.0
NGINX_IMAGE=nginx:1.30.4-alpine
ASTRA_PUBLIC_BIND_ADDRESS=0.0.0.0
ASTRA_PUBLIC_HTTP_PORT=80

# ── Database: MatrixOne ────────────────────────────────────────────────────
MATRIXONE_HOST=your-db-host
MATRIXONE_PORT=6001
MATRIXONE_USER=your-user
MATRIXONE_PASSWORD=your-secure-password
ASTRA_DATABASE=astra_runtime
#ASTRA_DATABASE_PREFIX=

# ── API server ─────────────────────────────────────────────────────────────
ASTRA_API_HOST=0.0.0.0
ASTRA_API_PORT=17001
ASTRA_CORS_ORIGINS=https://app.your-domain.com

# ── Logging ────────────────────────────────────────────────────────────────
# Standard RUST_LOG filter (e.g. warn,astra_runtime=info,astra.http.access=info).
#RUST_LOG=warn,astra_runtime=info

# ── Auth secrets (REQUIRED) ────────────────────────────────────────────────
# Replace every placeholder below. The deploy helper rejects template values,
# and the server refuses to start when required secrets are missing.
# Generate each secret independently with: openssl rand -hex 32
ASTRA_JWT_SECRET=CHANGE_ME_32_CHARS_MIN
ASTRA_JWT_ALGORITHM=HS256
ASTRA_JWT_ACCESS_TTL_MINUTES=60
ASTRA_JWT_REFRESH_TTL_DAYS=7
ASTRA_TOKEN_ENCRYPTION_KEY=CHANGE_ME_HIGH_ENTROPY_SECRET
ASTRA_RUNTIME_ROOT_SECRET=CHANGE_ME_32_CHARS_MIN

# ── LLM ────────────────────────────────────────────────────────────────────
# LLM models are managed server-side via `astra admin model add` / `model check`.
# Reasoning/judge selection: astra admin config set reasoning_offering_id <id>

# Harness snapshots are observability data. Realtime in-memory/SSE inspection is
# always available for active runs; durable DB history follows runtime.toml trace
# config (`trace.profile = "dev"` or the `harness_snapshots` trace category).

# Global provider admission is disabled unless explicitly enabled. Use it when
# pod-local run capacity can exceed the external LLM provider RPM/TPM.
#ASTRA_LLM_PROVIDER_ADMISSION_MODE=db_fixed_window
#ASTRA_LLM_PROVIDER_ADMISSION_RPM=60
#ASTRA_LLM_PROVIDER_ADMISSION_TPM=
# Provider admission scope/window/cleanup and run admission timeout are runtime
# policy, not deployment knobs.

# The built-in Work admission judge runs concurrently with each primary turn
# by default and is awaited only at a durable/effectful boundary.
# `capacity_aware` keeps Work admission enabled while provider admission
# accounts for its quota; unrelated optional judges remain capacity-gated.
# Use `disabled` to opt out of all auxiliary calls.
#ASTRA_AUX_LLM_POLICY=capacity_aware

# ── Memoria ────────────────────────────────────────────────────────────────
MEMORIA_BASE_URL=https://memoria.your-domain.com
MEMORIA_MASTER_KEY=CHANGE_ME_MEMORIA_MASTER_KEY
MEMORIA_EMBEDDING_PROVIDER=openai
MEMORIA_EMBEDDING_MODEL=BAAI/bge-m3
MEMORIA_EMBEDDING_DIM=1024
MEMORIA_EMBEDDING_API_KEY=
MEMORIA_EMBEDDING_BASE_URL=

# ── Optional integrations ──────────────────────────────────────────────────
#GITHUB_TOKEN=
#ASTRA_EDGE_REGISTRY=
#ASTRA_EDGE_HEARTBEAT_SECS=120
#ASTRA_EDGE_EXECUTOR_ID=
#ASTRA_EDGE_AGENT_ID=
