# Production Environment Configuration

# Database
MATRIXONE_HOST=your-db-host
MATRIXONE_PORT=6001
MATRIXONE_USER=your-user
MATRIXONE_PASSWORD=your-secure-password
MATRIXONE_DATABASE=agent_engine

# JWT Configuration (CRITICAL: Change these in production!)
JWT_SECRET_KEY=your-super-secret-key-min-32-characters-long-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Token Encryption (CRITICAL: MUST be set in production!)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Example: TOKEN_ENCRYPTION_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx=
TOKEN_ENCRYPTION_KEY=MUST_BE_SET_IN_PRODUCTION_OR_APP_WILL_FAIL

# Redis (optional, for future features)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=false

# CORS (configure allowed origins in production)
CORS_ORIGINS=https://your-frontend-domain.com,https://app.your-domain.com

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Rate Limiting (future)
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10
